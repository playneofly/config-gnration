{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "config-gnration",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  }
  // نکته: دیتابیس این پروژه PostgreSQL خارجی است (متغیر DATABASE_URL).
  // از داشبورد کلادفلر: Settings → Variables and Secrets → افزودن Secret با نام DATABASE_URL
}
